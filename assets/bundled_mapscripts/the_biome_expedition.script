Crumblewall
{
	spawn
	{
		wait 50
		constructible_class 3
	}
	death
	{
	wm_announce "Allies have blown up the Crumblewall!"
	}
}
endtele
{
    trigger perkele
    {
        setstate endtele1 default
        setstate eye invisible
        setstate endtele2 invisible
    }
}
endvittu
{
    trigger saatana
    {
        setstate endtele2 default
    }
}



flag1
{
	spawn
	{
		accum 1 set -1
	}

	trigger allied_capture				// Touched by an allied player
	{
		accum 0 abort_if_equal 1 		// do Allies own flag?

		accum 0 set 1 			// Allied own the flag
		setstate flag1_wobj default

		wm_announce "^7Allies captured Timberclimb!"
          alertentity flag1_wobj
          alertentity flag1_wobj


		setautospawn "Timberclimb"	1	// Set Allies to forward spawn
	}
}
