// ETJump mapscript for the_biome_expedition.bsp
// Modifications:
// - adjusted flags to be hidden by default and appear as captured
// - recreated end prints with 'target_delay' + 'target_print' entities with per-client wait cycles,
//   to fix them breaking when multiple people trigger the end simultaneously
// - re-created Crumblewall TOI, now shows the name when hovered over in limbo menu

game_manager
{
    spawn
    {
			create
			{
				"classname" "target_print"
				"origin" "-23544 4080 2128"
				"targetname" "target_print3"
				"message" "You have conquered The End!"
				"spawnflags" "12"
			}

			create
			{
				"classname" "target_delay"
				"origin" "-23544 4048 2128"
				"targetname" "target_print3"
				"wait" "2.5"
				"spawnflags" "1"
				"target" "target_print10"
			}

			create
			{
				"classname" "target_print"
				"origin" "-23512 4080 2128"
				"targetname" "target_print10"
				"message" "Map by purga&wing"
				"spawnflags" "12"
			}

			create
			{
				"classname" "target_delay"
				"origin" "-23512 4048 2128"
				"targetname" "target_print10"
				"wait" "1.5"
				"spawnflags" "1"
				"target" "target_print11"
			}

			create
			{
				"classname" "target_delay"
				"origin" "-23480 4048 2128"
				"targetname" "target_print11"
				"wait" "1.5"
				"spawnflags" "1"
				"target" "target_print12"
			}

			create
			{
				"classname" "target_print"
				"origin" "-23480 4080 2128"
				"targetname" "target_print11"
				"message" "Big Thanks to:"
				"spawnflags" "12"
			}

			create
			{
				"classname" "target_delay"
				"origin" "-23448 4048 2128"
				"targetname" "target_print12"
				"wait" "1.5"
				"spawnflags" "1"
				"target" "target_print13"
			}

			create
			{
				"classname" "target_print"
				"origin" "-23448 4080 2128"
				"targetname" "target_print12"
				"message" "-pierdole"
				"spawnflags" "12"
			}

			create
			{
				"classname" "target_print"
				"origin" "-23416 4080 2128"
				"targetname" "target_print13"
				"message" "-aciz"
				"spawnflags" "12"
			}

			create
			{
				"classname" "target_delay"
				"origin" "-23416 4048 2128"
				"targetname" "target_print13"
				"wait" "1.5"
				"spawnflags" "1"
				"target" "target_print14"
			}

			create
			{
				"classname" "target_delay"
				"origin" "-23384 4048 2128"
				"targetname" "target_print14"
				"wait" "1.5"
				"spawnflags" "1"
				"target" "target_print15"
			}

			create
			{
				"classname" "target_print"
				"origin" "-23384 4080 2128"
				"targetname" "target_print14"
				"message" "-sungi"
				"spawnflags" "12"
			}

			create
			{
				"classname" "target_print"
				"origin" "-23352 4080 2128"
				"targetname" "target_print15"
				"message" "And to YOU for playing!"
				"spawnflags" "12"
			}

			delete
			{
				classname "trigger_objective_info"
				track "the Crumblewall"
			}

			create
			{
				"classname" "trigger_objective_info"
				"target" "func_explosive1"
				"track" "the Crumblewall"
				"shortname" "Crumblewall"
				"spawnflags" "17"
				"model" "*13"
			}

        wait 100
        setstate objreturn_trigger invisible
        setstate obutrans default
        setstate trapdoor default
        trigger piston1 reset
        trigger piston2 reset
        trigger piston3 reset
        trigger piston4 reset
        trigger piston5 reset
        setstate endtele1 invisible
        setstate endtele2 invisible
        setstate eye default
        alertentity flag0_wobj
        alertentity flag0_wobj
    remapshader "textures/mc/itemframe_empty" "textures/mc/itemframe_empty"
    remapshader "textures/mc/itemframe_ender" "textures/mc/itemframe_ender"
    remapshader "textures/mc/stonepick" "textures/mc/stonepick"
    remapshader "textures/mc/bucket" "textures/mc/bucket"
    remapshader "textures/mc/ironingot" "textures/mc/ironingot"
    remapshader "textures/mc/ironpick" "textures/mc/ironpick"
    remapshader "textures/mc/diamonditem" "textures/mc/diamonditem"
    remapshader "textures/mc/diamondhelmet" "textures/mc/diamondhelmet"
    remapshader "textures/mc/blazerod" "textures/mc/blazerod"
    remapshader "textures/mc/potion" "textures/mc/potion"
    remapshaderflush

	setautospawn "The Echoing Cavern" 1





			wait 200
			setstate flag1_wobj invisible
			setstate flag2_wobj invisible
			setstate flag3_wobj invisible
			setstate flag4_wobj invisible
			setstate flag5_wobj invisible
			setstate flag6_wobj invisible
			setstate flag7_wobj invisible
			setstate flag8_wobj invisible
			setstate flag9_wobj invisible
			setstate flag10_wobj invisible
    }
}

obu
{
    trigger stolen
    {
        wait 45000
        setstate objreturn_trigger default
        wait 50
        setstate objreturn_trigger invisible
    }

    trigger captured
    {
        resetscript
        setstate objreturn_trigger invisible
	wm_teamvoiceannounce 1 "allies_hq_objective_captured"
        setstate trapdoor invisible
    remapshader "textures/mc/itemframe_empty" "textures/mc/itemframe_key"
    remapshaderflush
    }
    trigger dropped
    {
        resetscript
        setstate objreturn_trigger invisible
    }
    trigger returned
    {
        resetscript
        setstate objreturn_trigger invisible
	  wm_teamvoiceannounce 1 "allies_hq_objective_lost"

    }
}

vittu
{
    activate
    {
        trigger piston1 move
    }
}

piston1
{
    trigger reset
    {
        setposition pistonin1
    }
    trigger move
    {
        gotomarker pistonout1 500
        wait 1000
        gotomarker pistonin1 500
    }
}

