#include "ui/menudef.h"
#include "ui/menudef_ext.h"
#include "ui/menumacros.h"
#include "ui/menumacros_ext.h"

#define MENU_NAME "etjump_settings_crosshair_presets"
#define GROUP_NAME "group_etjump_settings_crosshair"

#define NUM_SUBMENUS 3
#define SIDEBAR_BTN_Y (SIDEBAR_Y + (SIDEBAR_H * 0.5) - (((NUM_SUBMENUS * SIDEBAR_BTN_H) + (MAIN_ELEMENT_MARGIN * (NUM_SUBMENUS - 1))) * 0.5))

// laid out top down: list, name field, then two rows of buttons
#define PRESET_LIST_X (SETTINGS_SUBW_X + 8)
#define PRESET_LIST_Y (SETTINGS_ITEM_Y + 4)
#define PRESET_LIST_W (SETTINGS_SUBW_W - 16)
#define PRESET_LIST_H 170

#define PRESET_NAME_Y (PRESET_LIST_Y + PRESET_LIST_H + 12)
#define PRESET_BTN_ROW1_Y (PRESET_NAME_Y + SETTINGS_EF_H + 12)
#define PRESET_BTN_H 16
#define PRESET_BTN_W ((SETTINGS_ITEM_W - (MAIN_ELEMENT_MARGIN * 2)) / 3)
#define PRESET_BTN_X(col) (SETTINGS_ITEM_X + ((PRESET_BTN_W + MAIN_ELEMENT_MARGIN) * col))

menuDef {
    name MENU_NAME
    visible 0
    fullscreen 0
    rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
    style WINDOW_STYLE_FILLED
    centered

    onOpen {
        uiScript crosshairRefreshPresets ;
        conditionalscript uiCheckBackground 2
            ( BACKGROUND_ON )
            ( BACKGROUND_OFF )
    }

    onESC {
        close MENU_NAME; open etjump_settings_hud1_crosshair
    }

    WINDOW("ETJUMP SETTINGS", 90)

    MAINBUTTON          (1, "GENERAL", close MENU_NAME; open etjump_settings_general_gameplay)
    MAINBUTTON          (2, "GRAPHICS", close MENU_NAME; open etjump_settings_graphics_visuals)
    MAINBUTTON_ACTIVE   (3, "BASIC HUD", close MENU_NAME; open etjump_settings_hud1_crosshair)
    MAINBUTTON          (4, "ADV HUD", close MENU_NAME; open etjump_settings_hud2_cgaz)
    MAINBUTTON          (5, "AUDIO", close MENU_NAME; open etjump_settings_audio)
    MAINBUTTON          (6, "TIMERUNS", close MENU_NAME; open etjump_settings_timeruns_runtimer)
    MAINBUTTON          (7, "DEMOS", close MENU_NAME; open etjump_settings_demos_autodemo)

    WINDOW_BLANK(SIDEBAR_X, SIDEBAR_Y, SIDEBAR_W, SIDEBAR_H)

    SIDEBUTTON          (1, "SHAPE", close MENU_NAME; open CROSSHAIR_EDITOR_MENU)
    SIDEBUTTON          (2, "COLORS", close MENU_NAME; open CROSSHAIR_COLORS_MENU)
    SIDEBUTTON_ACTIVE   (3, "PRESETS", close MENU_NAME; open MENU_NAME)

    SUBWINDOW(SETTINGS_SUBW_X, SETTINGS_SUBW_Y, SETTINGS_SUBW_W, SETTINGS_SUBW_H, "CROSSHAIR PRESETS")

        // click to pick, double click to load. scrolls on its own once there
        // are more presets than fit.
        itemDef {
            name            "crosshair_preset_list"
            group           GROUP_NAME
            rect            $evalfloat(PRESET_LIST_X) $evalfloat(PRESET_LIST_Y) $evalfloat(PRESET_LIST_W) $evalfloat(PRESET_LIST_H)
            type            ITEM_TYPE_LISTBOX
            textfont        UI_FONT_COURBD_21
            textscale       .2
            textaligny      -3
            style           WINDOW_STYLE_FILLED
            backcolor       .1 .1 .1 .4
            forecolor       .6 .6 .6 1
            outlinecolor    .5 .5 .5 .4
            border          WINDOW_BORDER_FULL
            bordercolor     .5 .5 .5 .3
            feeder          FEEDER_CROSSHAIR_PRESETS
            elementtype     LISTBOX_TEXT
            elementwidth    200
            elementheight   12
            columns         1 4 200 89
            visible         1
            tooltip         "Saved crosshairs. Click to pick one, double click to load it"

            doubleClick {
                uiScript crosshairLoadPreset
            }
        }

        // keep macro args bare, EDITFIELD_EXT and BUTTON wrap them in $evalfloat
        // themselves and nesting it fails to parse, which throws away the whole menu
        EDITFIELD_EXT       (SETTINGS_ITEM_X, PRESET_NAME_Y, SETTINGS_ITEM_W, SETTINGS_EF_H, SETTINGS_ITEM_W - MAIN_ELEMENT_MARGIN, "Save as:", 0.2, SETTINGS_ITEM_H, "etj_cePresetName", 64, 32, "Name for SAVE. Picking a preset above fills this in, so saving overwrites it")

        BUTTON              (PRESET_BTN_X(0), PRESET_BTN_ROW1_Y, PRESET_BTN_W, PRESET_BTN_H, "SAVE", 0.2, 11, uiScript crosshairSavePreset)
        BUTTON              (PRESET_BTN_X(1), PRESET_BTN_ROW1_Y, PRESET_BTN_W, PRESET_BTN_H, "LOAD", 0.2, 11, uiScript crosshairLoadPreset)
        BUTTON              (PRESET_BTN_X(2), PRESET_BTN_ROW1_Y, PRESET_BTN_W, PRESET_BTN_H, "DELETE", 0.2, 11, uiScript crosshairDeletePreset)

    LOWERBUTTON(1, "BACK", close MENU_NAME; open etjump_settings_hud1_crosshair)
    LOWERBUTTON(2, "WRITE CONFIG", clearfocus; uiScript uiPreviousMenu MENU_NAME; open etjump_settings_popup_writeconfig)

#ifndef FUI
    LOWERBUTTON(3, "TOGGLE BACKGROUND", conditionalscript uiToggleBackground 2 ( BACKGROUND_OFF ) ( BACKGROUND_ON ) )
#endif

}
